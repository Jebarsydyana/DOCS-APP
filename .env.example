# Required. Pooled connection string (host contains "-pooler"), used by the running app.
DATABASE_URL=""
# Required. Direct (non-pooled) connection string, used by Prisma migrations.
DIRECT_URL=""
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Optional. Name shown in the sidebar, login page and browser tab. Defaults to "Docs".
NEXT_PUBLIC_APP_NAME="Docs"
